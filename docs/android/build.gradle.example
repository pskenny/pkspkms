// Reference Gradle snippet for integrating pkspkms-core into an Android app.
// Copy the relevant parts into your app module's build.gradle (or build.gradle.kts).

android {
    // xerial sqlite-jdbc requires desugared Java 8+ library support.
    compileOptions {
        coreLibraryDesugaringEnabled true
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    kotlinOptions {
        jvmTarget = "17"
    }
}

dependencies {
    // --- pkspkms-core ---
    // Option A: published to local Maven (run `mvn install` in the pkspkms repo root first)
    implementation 'io.pskenny.pkspkms:pkspkms-core:0.1.0'

    // Option B: Gradle composite build (if the Android project is in the same checkout)
    // In settings.gradle:
    //   includeBuild '../PKSPKMS'
    // Then in build.gradle:
    //   implementation 'io.pskenny.pkspkms:pkspkms-core:0.1.0'

    // --- SQLite JDBC driver (with native .so files bundled inside the JAR) ---
    implementation 'org.xerial:sqlite-jdbc:3.51.3.0'

    // --- SLF4J binding ---
    // slf4j-simple writes to System.err, which Android redirects to logcat.
    // Place a simplelogger.properties file in src/main/resources/ to configure
    // (optional — defaults are fine for most cases).
    implementation 'org.slf4j:slf4j-simple:2.0.17'

    // --- Core transitive dependencies ---
    // These should resolve automatically via Maven transitive resolution, but
    // if your build excludes transitive deps, declare them explicitly:
    implementation 'org.commonmark:commonmark:0.27.1'
    implementation 'com.fasterxml.jackson.core:jackson-databind:2.18.6'
    implementation 'org.luaj:luaj-jse:3.0.1'
    implementation 'org.yaml:snakeyaml:2.6'
    implementation 'org.nanohttpd:nanohttpd:2.3.1'
    implementation 'commons-codec:commons-codec:1.22.0'

    // --- Java 8 desugaring ---
    coreLibraryDesugaring 'com.android.tools:desugar_jdk_libs:2.1.2'
}

// --- Native library extraction ---
// xerial's sqlite-jdbc JAR contains Android-native .so files under
// org/sqlite/native/Linux-Android/{aarch64,arm,x86,x86_64}/.
// Android expects these in src/main/jniLibs/{abi}/ with ABI-standard names.
// This task extracts and renames them automatically before the build.
task extractSqliteNatives {
    doLast {
        def jarFile = configurations.runtimeClasspath.files.find { it.name.contains('sqlite-jdbc') }
        if (jarFile == null) return

        def extractDir = file("${buildDir}/extracted-sqlite-natives")
        copy {
            from(zipTree(jarFile)) {
                include 'org/sqlite/native/Linux-Android/**'
            }
            into extractDir
        }

        // Map xerial directory names to Android ABI names
        def abiMap = [
            'aarch64': 'arm64-v8a',
            'arm'    : 'armeabi-v7a',
            'x86'    : 'x86',
            'x86_64' : 'x86_64'
        ]
        abiMap.each { src, dst ->
            def srcDir = file("${extractDir}/org/sqlite/native/Linux-Android/${src}")
            if (srcDir.exists()) {
                copy {
                    from(srcDir) {
                        include '*.so'
                    }
                    into "src/main/jniLibs/${dst}"
                }
            }
        }
    }
}
preBuild.dependsOn extractSqliteNatives